# Chatbot (a Evolution tem configuração própria em evolution-api/.env)
SERVER_PORT=8081

# Evolution API
EVOLUTION_INSTANCE=MZN-LOCAL
EVOLUTION_API_KEY=GERE_UMA_CHAVE_FORTE_AQUI

# Enquanto false, o Spring recebe/processa mensagens, mas não responde no WhatsApp.
EVOLUTION_SEND_ENABLED=false

# Números completos com DDI + DDD, separados por vírgula. Vazio bloqueia todos.
# Exemplo fictício: BOT_ALLOWED_NUMBERS=5596999990001,5596999990002
BOT_ALLOWED_NUMBERS=

# IA executada localmente pelo serviço Ollama
AI_ENABLED=true
OLLAMA_MODEL=qwen3:4b
AI_TIMEOUT=60s
# Fora do Docker, o chatbot usa http://localhost:11434 por padrão.
