# Portas locais
SERVER_PORT=8081
EVOLUTION_PORT=8080

# Evolution API
EVOLUTION_INSTANCE=MZN-LOCAL
EVOLUTION_API_KEY=GERE_UMA_CHAVE_FORTE_AQUI

# Enquanto false, o Spring recebe/processa mensagens, mas não responde no WhatsApp.
EVOLUTION_SEND_ENABLED=false

# PostgreSQL da Evolution API
POSTGRES_DATABASE=evolution
POSTGRES_USERNAME=evolution
POSTGRES_PASSWORD=GERE_UMA_SENHA_FORTE_AQUI
